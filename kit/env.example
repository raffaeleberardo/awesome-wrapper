# Git Wrapped: questo file è FACOLTATIVO. URL di GitLab, gruppo e token si inseriscono
# direttamente nella pagina dell'app. Serve solo per le opzioni qui sotto.
# Per usarlo: rinominalo in ".env" (con il punto davanti) e compila i valori.
# Il file .env resta solo sul tuo computer: non mandarlo a nessuno, non incollarlo in chat.

# Anno raccontato e fuso orario.
WRAPPED_YEAR=2026
TZ=Europe/Rome

# Solo se il GitLab aziendale usa un certificato interno non riconosciuto: incolla il PEM
# tra virgolette doppie, anche su più righe. Altrimenti lascia vuoto.
GITLAB_CA_CERT=

# Per saltare la schermata iniziale: indirizzo, gruppo e il TUO Personal Access Token
# (scope read_api). I token di gruppo o di progetto non funzionano: appartengono a un bot.
GITLAB_URL=https://gitlab.com
GITLAB_GROUP=
GITLAB_TOKEN=
