# Git Wrapped: rinomina questo file in ".env" (con il punto davanti) e compila i valori.
# Il file .env resta solo sul tuo computer: non mandarlo a nessuno, non incollarlo in chat.

# false = dati veri dal tuo GitLab. Metti true per tornare alla demo con dati inventati.
DEMO_MODE=false

# Indirizzo del GitLab aziendale, per esempio https://gitlab.tuaazienda.it
GITLAB_URL=https://gitlab.com

# Il TUO Personal Access Token con il solo scope read_api (vedi LEGGIMI.txt).
# I token di gruppo o di progetto non funzionano: appartengono a un bot, non a te.
GITLAB_TOKEN=

# Facoltativo: percorso del gruppo da leggere, per esempio team/backend.
# Vuoto = tutti i gruppi di cui fai parte.
GITLAB_GROUP=

# Anno raccontato e fuso orario.
WRAPPED_YEAR=2026
TZ=Europe/Rome

# Solo se il GitLab aziendale usa un certificato interno non riconosciuto: incolla il PEM
# tra virgolette doppie, anche su più righe. Altrimenti lascia vuoto.
GITLAB_CA_CERT=
