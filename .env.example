# Git Wrapped: copia in `.env` (cp .env.example .env) e compila. Non committare `.env`.

# Usa i dati finti. `make demo` la forza a true e `make up` a false: questo valore conta
# solo se avvii a mano con `docker compose up`. Senza make: DEMO_MODE=false per i dati reali.
DEMO_MODE=true

# Istanza GitLab, anche self-hosted.
GITLAB_URL=https://gitlab.com

# Il tuo Personal Access Token con il solo scope `read_api` (vedi docs/gitlab-token.md).
# L'app mostra il wrapped di chi possiede il token: Group e Project Access Token sono bot
# e vengono rifiutati.
GITLAB_TOKEN=

# Facoltativo: percorso di un gruppo, per esempio azienda/team. Limita la lettura ai progetti
# del gruppo e dei sottogruppi. Se vuoto si leggono tutti i gruppi di cui fai parte (almeno Guest).
GITLAB_GROUP=

# Anno raccontato.
WRAPPED_YEAR=2026

# Fuso per orari e badge notturni.
TZ=Europe/Rome

# Durata della cache in memoria, in minuti (statistiche e dati letti da GitLab).
CACHE_TTL_MINUTES=15

# Certificato della CA aziendale per istanze interne. Lascia vuoto se non serve.
# Incolla il contenuto PEM tra virgolette doppie, anche su più righe:
# GITLAB_CA_CERT="-----BEGIN CERTIFICATE-----
# MIIC...
# -----END CERTIFICATE-----"
# Un percorso di file funziona solo se monti tu il file nel container `api` (compose.yaml non lo fa).
GITLAB_CA_CERT=
