# Git Wrapped: copia in `.env` (cp .env.example .env) e compila. Non committare `.env`.

# Usa i dati finti; diventa "false" quando si mette il token.
DEMO_MODE=true

# Istanza GitLab, anche self-hosted.
GITLAB_URL=https://gitlab.com

# Group Access Token con scope `read_api` (vedi docs/gitlab-token.md).
GITLAB_TOKEN=

# Percorso del gruppo, per esempio azienda/team.
GITLAB_GROUP=

# Anno raccontato.
WRAPPED_YEAR=2026

# Fuso per orari e badge notturni.
TZ=Europe/Rome

# Durata della cache in memoria, in minuti.
CACHE_TTL_MINUTES=15

# Certificato (PEM) per istanze interne con CA aziendale. Lascia vuoto se non serve.
GITLAB_CA_CERT=
